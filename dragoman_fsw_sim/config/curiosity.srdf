<?xml version="1.0"?>

<!-- Hand written by kenji on Dec 4 2025 -->
<robot name="curiosity">

  <group name="arm">
    <joint name="arm_01_joint" />
    <joint name="arm_02_joint" />
    <joint name="arm_03_joint" />
    <joint name="arm_04_joint" />
    <joint name="arm_tools_joint" />
  </group>

  <group name="mast">
    <joint name="mast_p_joint" />
    <joint name="mast_02_joint" />
    <joint name="mast_cameras_joint" />
  </group>

  <group_state group="arm" name="zero">
    <joint name="arm_01_joint" value="0.0" />
    <joint name="arm_02_joint" value="0.0" />
    <joint name="arm_03_joint" value="0.0" />
    <joint name="arm_04_joint" value="0.0" />
    <joint name="arm_tools_joint" value="0.0" />
  </group_state>

  <group_state group="arm" name="test">
    <joint name="arm_01_joint" value="0.5" />
    <joint name="arm_02_joint" value="0.5" />
    <joint name="arm_03_joint" value="0.5" />
    <joint name="arm_04_joint" value="0.5" />
    <joint name="arm_tools_joint" value="0.5" />
  </group_state>

  <group_state group="mast" name="zero">
    <joint name="mast_p_joint" value="0.0" />
    <joint name="mast_02_joint" value="0.0" />
    <joint name="mast_cameras_joint" value="0.0" />
  </group_state>

  <group_state group="mast" name="test">
    <joint name="mast_p_joint" value="0.5" />
    <joint name="mast_02_joint" value="0.5" />
    <joint name="mast_cameras_joint" value="0.5" />
  </group_state>
</robot>
