<root BTCPP_format="4">

  <BehaviorTree ID="MainTree">
    
      <Sequence>

        <!-- Set speed -->               
        <SetNodeParam node="/planner_node" param="param.execution_speed_scalar" type="double" value="0.5" />        

        <!-- Move arm up, away from panel -->
        <ICSetGoalPose robot="" group="clr" plan="true" execute="true" goal_frame="world" 
                       goal_xyz="-1.741; 0.285; 1.120" goal_quat="-0.067; 0.047; 0.670; 0.738"  />

        <!-- Go to point 1 to take a picture (trainer door) -->                       
        <ICSetGoalPose robot="" group="clr" plan="true" execute="true" goal_frame="world" 
                       goal_xyz="-1.645; 0.382; 1.176" goal_quat="-0.067; 0.047; 0.670; 0.738"  />
                       
        <TakePicture topic="/wrist_mounted_camera/color/image_raw"/>

        <!-- Go to point 2 to take a picture -->                       
        <ICSetGoalPose robot="" group="clr" plan="true" execute="true" goal_frame="world" 
                       goal_xyz="0.207; 0.426; 1.206" goal_quat="-0.067; 0.047; 0.670; 0.738"  />
                       
        <TakePicture topic="/wrist_mounted_camera/color/image_raw"/>

        <!-- Go to point 3 to take a picture -->
        <ICSetGoalPose robot="" group="clr" plan="true" execute="true" goal_frame="world" 
                       goal_xyz="0.247; 0.524; 1.111" goal_quat="-0.139; 0.398; 0.113; 0.900"  />
                       
        <TakePicture topic="/wrist_mounted_camera/color/image_raw"/>
  
        
      </Sequence>

  </BehaviorTree>

</root>
