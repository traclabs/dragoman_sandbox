  <version>0.0.0</version>
  <description>Ground visualization example using the Dragoman Yamcs ROS bridge</description>
  <maintainer email="robotics@traclabs.com">TRACLabs Robotics</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>curiosity_description</exec_depend>
